{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd hv1 && npm install --include=dev",
  "buildCommand": "cd hv1 && node scripts/link-client-node-modules.cjs && npx vite build",
  "outputDirectory": "hv1/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
