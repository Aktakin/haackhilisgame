{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/link-client-node-modules.cjs && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --include=dev",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
